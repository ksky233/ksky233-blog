---
import { GITHUB_URL, HOME_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-logo" href="/" aria-label={`${SITE_TITLE} 首页`}>
			<span aria-hidden="true">✦</span>
			<span>{SITE_TITLE}</span>
		</a>
		<nav class="nav-links" aria-label="主导航">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/articles">文章</HeaderLink>
			<HeaderLink href="/series">系列</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<a href="/rss.xml">RSS</a>
		</nav>
		<div class="external-links">
			<a href={HOME_URL}>主页 <span aria-hidden="true">↗</span></a>
			<a href={GITHUB_URL} rel="noreferrer" target="_blank">GitHub <span aria-hidden="true">↗</span></a>
		</div>
	</div>
</header>
